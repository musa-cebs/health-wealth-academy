# Anthropic key for the coach and roleplay. Create a NEW key; never reuse the one in the Make scenario.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: if set, API routes require this code (sent by the app as x-access-code). Replace with real login before launch.
ACADEMY_ACCESS_CODE=
# Single sign-on with Vendor AI. Vendor AI signs a short-lived HS256 token with this shared secret. Leave empty only for local development.
SSO_SECRET=
SESSION_SECRET=
# Postgres connection string (added automatically by the Neon integration in Vercel).
DATABASE_URL=
