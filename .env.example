# Anthropic key for the coach and roleplay. Create a NEW key; never reuse the one in the Make scenario.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: if set, API routes require this code (sent by the app as x-access-code). Replace with real login before launch.
ACADEMY_ACCESS_CODE=
# Single sign-on with Vendor AI. Vendor AI signs a short-lived HS256 token with this shared secret. Leave empty only for local development.
SSO_SECRET=
SESSION_SECRET=
# Postgres connection string (added automatically by the Neon integration in Vercel).
DATABASE_URL=

# Pocket Coach (WhatsApp). Use the NEW training number's Meta Cloud API values.
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Pilot access: comma-separated numbers in 27… format. Remove once Vendor AI lookup is live.
WA_ALLOWLIST=
# Vendor AI member lookup (returns member_id, name, upline, active for ?phone=27…).
VENDORAI_MEMBER_URL=
ACADEMY_API_SECRET=
# Vercel Cron sends this as a Bearer token to /api/wa/daily.
CRON_SECRET=
# Approved daily-nudge template name in Meta.
WA_DAILY_TEMPLATE=pocket_coach_daily
